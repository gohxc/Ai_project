# NVIDIA NIM 配置
NVIDIA_NIM_API_KEY=""


# OpenRouter 配置
OPENROUTER_API_KEY=""


# DeepSeek 配置（使用 api.deepseek.com/anthropic 的原生 Anthropic Messages）
DEEPSEEK_API_KEY=""


# Kimi 配置（Moonshot 兼容 OpenAI 的 API）
KIMI_API_KEY=""


# Wafer 配置（使用 pass.wafer.ai/v1/messages 的原生 Anthropic Messages）
WAFER_API_KEY=""


# OpenCode Zen 配置（opencode.ai/zen/v1 上兼容 OpenAI 的 Chat Completions）
OPENCODE_API_KEY=""


# Z.ai 配置（api.z.ai/api/anthropic 上兼容 Anthropic 的 Messages）
ZAI_API_KEY=""
ZAI_BASE_URL="https://api.z.ai/api/coding/paas/v4"


# LM Studio 配置（本地提供方，无需 API key）
LM_STUDIO_BASE_URL="http://localhost:1234/v1"


# Llama.cpp 配置（本地提供方，无需 API key）
LLAMACPP_BASE_URL="http://localhost:8080/v1"


# Ollama 配置（本地提供方，无需 API key）
OLLAMA_BASE_URL="http://localhost:11434"


# 所有 Claude 模型请求都会映射到这些模型；MODEL 是回退模型
# 格式：provider_type/model/name
# 有效提供方："nvidia_nim" | "open_router" | "deepseek" | "lmstudio" | "llamacpp" | "ollama" | "kimi" | "wafer" | "opencode" | "zai"
MODEL_OPUS=
MODEL_SONNET=
MODEL_HAIKU=
MODEL="nvidia_nim/nvidia/nemotron-3-super-120b-a12b"


# 可选的在线 smoke 模型覆盖。即使 MODEL/MODEL_* 路由到其他提供方，
# 每个已配置提供方的 smoke 仍会各运行一次。
FCC_SMOKE_MODEL_NVIDIA_NIM=
FCC_SMOKE_MODEL_OPEN_ROUTER=
FCC_SMOKE_MODEL_DEEPSEEK=
FCC_SMOKE_MODEL_LMSTUDIO=
FCC_SMOKE_MODEL_LLAMACPP=
FCC_SMOKE_MODEL_OLLAMA=
FCC_SMOKE_MODEL_KIMI=
FCC_SMOKE_MODEL_WAFER=
FCC_SMOKE_MODEL_OPENCODE=
FCC_SMOKE_MODEL_ZAI=
FCC_SMOKE_NIM_MODELS=
FCC_SMOKE_NIM_EXTRA_MODELS=
FCC_SMOKE_OPENROUTER_FREE_MODELS=
FCC_SMOKE_OPENROUTER_FREE_EXTRA_MODELS=


# 思考输出
# 每个 Claude 模型对应的提供方 reasoning 请求和 Claude thinking block 开关。
# 单模型开关留空时继承 ENABLE_MODEL_THINKING。
ENABLE_OPUS_THINKING=
ENABLE_SONNET_THINKING=
ENABLE_HAIKU_THINKING=
ENABLE_MODEL_THINKING=true


# 提供方配置
# 每个提供方都支持独立代理：http 和 socks5，例如："http://username:password@host:port"
NVIDIA_NIM_PROXY=""
OPENROUTER_PROXY=""
LMSTUDIO_PROXY=""
LLAMACPP_PROXY=""
KIMI_PROXY=""
WAFER_PROXY=""
OPENCODE_PROXY=""
ZAI_PROXY=""

PROVIDER_RATE_LIMIT=1
PROVIDER_RATE_WINDOW=3
PROVIDER_MAX_CONCURRENCY=5


# 提供方 API 请求的 HTTP 客户端超时（秒）
HTTP_READ_TIMEOUT=300
HTTP_WRITE_TIMEOUT=60
HTTP_CONNECT_TIMEOUT=60


# 可选服务端 API key（Anthropic 风格）
ANTHROPIC_AUTH_TOKEN="freecc"


# 消息平台："telegram" | "discord" | "none"
MESSAGING_PLATFORM="discord"
MESSAGING_RATE_LIMIT=1
MESSAGING_RATE_WINDOW=1


# 语音备注转写
VOICE_NOTE_ENABLED=false
# WHISPER_DEVICE："cpu" | "cuda" | "nvidia_nim"
# - "cpu"/"cuda"：Hugging Face transformers Whisper（离线、免费；安装命令：uv sync --extra voice_local）
# - "nvidia_nim"：通过 Riva gRPC 调用 NVIDIA NIM Whisper（需要 NVIDIA_NIM_API_KEY；安装命令：uv sync --extra voice）
# （与 MODEL=nvidia_nim/... 相互独立：MODEL 选择聊天提供方，这里只选择语音 STT。）
WHISPER_DEVICE="nvidia_nim"
# WHISPER_MODEL：
# - cpu/cuda：Hugging Face ID 或短名称（tiny、base、small、medium、large-v2、large-v3、large-v3-turbo）
# - nvidia_nim：NVIDIA NIM 模型（例如 "nvidia/parakeet-ctc-1.1b-asr"、"openai/whisper-large-v3"）
# - nvidia_nim 默认使用 "openai/whisper-large-v3" 以获得最佳效果
WHISPER_MODEL="openai/whisper-large-v3"
HF_TOKEN=""


# Telegram 配置
TELEGRAM_BOT_TOKEN=""
ALLOWED_TELEGRAM_USER_ID=""


# Discord 配置
DISCORD_BOT_TOKEN=""
ALLOWED_DISCORD_CHANNELS=""


# Agent 配置
CLAUDE_WORKSPACE="./agent_workspace"
ALLOWED_DIR=""
CLAUDE_CLI_BIN="claude"
FAST_PREFIX_DETECTION=true
ENABLE_NETWORK_PROBE_MOCK=true
ENABLE_TITLE_GENERATION_SKIP=true
ENABLE_SUGGESTION_MODE_SKIP=true
ENABLE_FILEPATH_EXTRACTION_MOCK=true


# 本地 Anthropic web_search / web_fetch 处理（会发起出站 HTTP；默认开启）
ENABLE_WEB_SERVER_TOOLS=true
WEB_FETCH_ALLOWED_SCHEMES=http,https
WEB_FETCH_ALLOW_PRIVATE_NETWORKS=false


# 结构化 TRACE 日志：带 `"trace": true` 的行会合并 ingress/routing/cli/provider/egress
# 阶段。对话文本会原样记录在这些载荷中。键名类似 ``api_key`` / ``authorization`` 的值会被脱敏。
# 原始传输载荷仍需要开启下方 LOG_RAW_* 开关。
#
# 详细诊断（生产环境避免记录原始 prompt / SSE body）
DEBUG_PLATFORM_EDITS=false
DEBUG_SUBAGENT_STACK=false
# 为 true 时，也允许 DEBUG 级别的 httpx/httpcore/telegram 日志噪声（不只是载荷日志）。
LOG_RAW_API_PAYLOADS=false
LOG_RAW_SSE_EVENTS=false
# 为 true 时，记录未处理错误的完整异常文本和回溯（可能泄露请求派生数据）。
LOG_API_ERROR_TRACEBACKS=false
# 为 true 时，仅在消息适配器中记录消息/转写文本预览（handler ingress 仍会单独 TRACE 原始文本）。
LOG_RAW_MESSAGING_CONTENT=false
# 为 true 时，记录完整 Claude CLI stderr、非 JSON stdout 行和解析器错误文本。
LOG_RAW_CLI_DIAGNOSTICS=false
# 为 true 时，在消息路径中记录完整异常和 CLI 错误字符串（可能泄露用户内容）。
LOG_MESSAGING_ERROR_DETAILS=false
